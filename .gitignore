
# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc

# Notebook checkpoints (any folder)
**/.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Raw dataset (too large for GitHub)
raw/
arxiv-metadata-oai-snapshot.json

# Full-mode processed dataset and outputs
outputs/
arxiv_processed.jsonl

# Large numerical files (ignored globally)
*.npy
*.npz
*.jsonl

# Allow sample data files (override ignore)
!data/sample_data.jsonl
!data/sample_embeddings.txt.npy
!data/sample_cluster_labels.txt
!data/metadata.jsonl

# Allow all source code
!src/*.py

# Allow notebooks
!notebooks/*.ipynb

# Allow README and config files
!README.md
!.gitignore
!requirements.txt

